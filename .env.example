# Google AI Studio で発行したAPIキーを設定してください
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# 使用するGeminiモデル（省略時は gemini-3.7-flash を使用）
# もし利用できない場合は gemini-2.5-flash などに変更してください
GEMINI_MODEL=gemini-3.7-flash

# Googleスプレッドシート連携用のサービスアカウントJSONファイルのパス
GOOGLE_SERVICE_ACCOUNT_FILE=your-service-account-file.json

# 連携先のスプレッドシート名（省略時は "vv古着売上管理" を使用）
GOOGLE_SHEET_NAME=vv古着売上管理
